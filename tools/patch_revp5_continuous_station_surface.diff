+def _build_continuous_station_ribbon(path: np.ndarray, half_width: float) -> dict:
+    """Build a non-folding linear station field around the accepted polyline."""
+    coordinates = np.asarray(path[:, :2], dtype=float)
+    station = cumulative_xy(path)
+    closed = bool(np.linalg.norm(coordinates[0] - coordinates[-1]) <= 1.0e-7)
+    if closed:
+        working = coordinates[:-1]
+        working_station = station[:-1]
+    else:
+        working = coordinates
+        working_station = station
+    if len(working) < 2:
+        raise RuntimeError("Road alignment is too short for a station ribbon")
+
+    segment_vectors = np.diff(working, axis=0)
+    if closed:
+        segment_vectors = np.vstack([segment_vectors, working[0] - working[-1]])
+    segment_lengths = np.linalg.norm(segment_vectors, axis=1)
+    if np.any(segment_lengths <= 1.0e-9):
+        raise RuntimeError("Road alignment contains a zero-length segment")
+    directions = segment_vectors / segment_lengths[:, None]
+    segment_normals = np.column_stack([-directions[:, 1], directions[:, 0]])

+    offsets = np.empty_like(working)
+    for index in range(len(working)):
+        if not closed and index == 0:
+            offsets[index] = float(half_width) * segment_normals[0]
+            continue
+        if not closed and index == len(working) - 1:
+            offsets[index] = float(half_width) * segment_normals[-1]
+            continue
+        previous = segment_normals[(index - 1) % len(segment_normals)]
+        following = segment_normals[index % len(segment_normals)]
+        bisector = previous + following
+        magnitude = float(np.linalg.norm(bisector))
+        if magnitude <= 1.0e-9:
+            raise RuntimeError("Station ribbon encountered an unfilleted 180-degree vertex")
+        bisector /= magnitude
+        denominator = float(np.dot(bisector, previous))
+        if denominator <= 1.0e-6:
+            raise RuntimeError("Station ribbon miter is outside the accepted curvature envelope")
+        offsets[index] = bisector * (float(half_width) / denominator)

+    lateral_steps = max(1, int(math.ceil(float(half_width) / 2.0)))
+    lateral_offsets = np.linspace(
+        -float(half_width),
+        float(half_width),
+        2 * lateral_steps + 1,
+    )
+    sections = working[:, None, :] + (
+        lateral_offsets[None, :, None] / float(half_width)
+    ) * offsets[:, None, :]
+    triangles = []
+    station_values = []
+    triangle_polygons = []
+    edge_map = {}
+    segment_count = len(working) if closed else len(working) - 1
+    constant_closed_profile = bool(
+        closed and float(np.ptp(np.asarray(path[:, 2], dtype=float))) <= 1.0e-9
+    )
+
+    def add_triangle(points, values) -> None:
+        points = np.asarray(points, dtype=float)
+        area2 = float(np.cross(points[1] - points[0], points[2] - points[0]))
+        if abs(area2) <= 1.0e-10:
+            raise RuntimeError("Station ribbon contains a zero-area reference triangle")
+        if area2 < 0.0:
+            points = points[[0, 2, 1]]
+            values = np.asarray(values, dtype=float)[[0, 2, 1]]
+        else:
+            values = np.asarray(values, dtype=float)
+        triangles.append(points)
+        station_values.append(values)
+        triangle_polygons.append(Polygon(points))
+        for first, second in ((0, 1), (1, 2), (2, 0)):
+            a = tuple(np.round(points[first], 8))
+            b = tuple(np.round(points[second], 8))
+            key = tuple(sorted((a, b)))
+            edge_map[key] = (points[first].copy(), points[second].copy())
+
+    for index in range(segment_count):
+        following = (index + 1) % len(working)
+        first_station = 0.0 if constant_closed_profile else float(working_station[index])
+        second_station = 0.0 if constant_closed_profile else float(working_station[following])
+        for lateral_index in range(len(lateral_offsets) - 1):
+            first_low = sections[index, lateral_index]
+            first_high = sections[index, lateral_index + 1]
+            second_low = sections[following, lateral_index]
+            second_high = sections[following, lateral_index + 1]
+            add_triangle(
+                [first_low, second_low, second_high],
+                [first_station, second_station, second_station],
+            )
+            add_triangle(
+                [first_low, second_high, first_high],
+                [first_station, second_station, first_station],
+            )
+
+    breaklines = [LineString([first, second]) for first, second in edge_map.values()]
+
+    return {
+        "triangles": np.asarray(triangles, dtype=float),
+        "station_values": np.asarray(station_values, dtype=float),
+        "tree": STRtree(triangle_polygons),
+        "breaklines": breaklines,
+    }
+
