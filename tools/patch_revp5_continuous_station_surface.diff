+def _station_from_ribbon(ribbon: dict, point: Point) -> float | None:
+    candidate_indices = np.atleast_1d(ribbon["tree"].query(point)).astype(int)
+    coordinate = np.asarray([point.x, point.y], dtype=float)
+    candidates = []
+    for index in candidate_indices:
+        triangle = ribbon["triangles"][index]
+        first, second, third = triangle
+        denominator = float(np.cross(second - first, third - first))
+        if abs(denominator) <= 1.0e-12:
+            continue
+        relative = coordinate - first
+        weight_second = float(np.cross(relative, third - first) / denominator)
+        weight_third = float(np.cross(second - first, relative) / denominator)
+        weight_first = 1.0 - weight_second - weight_third
+        weights = np.asarray([weight_first, weight_second, weight_third], dtype=float)
+        if float(np.min(weights)) >= -1.0e-8:
+            candidates.append(float(np.dot(weights, ribbon["station_values"][index])))
+    if not candidates:
+        return None
+    if max(candidates) - min(candidates) > 1.0e-4:
+        raise RuntimeError(
+            "Station ribbon is multi-valued at a road-surface sample: "
+            f"range={max(candidates) - min(candidates):.9f} m"
+        )
+    return float(np.mean(candidates))
+
